# ==============================================================================
# AuraSun Solar Website Platform - Environment Variables
# Copy this file to .env.local for local development.
# Configure each client deployment with its own unique production values.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. SITE & CANONICAL DOMAIN
# ------------------------------------------------------------------------------
# The public production URL of this solar client's website (used for sitemaps, JSON-LD, metadata)
NEXT_PUBLIC_SITE_URL="https://aurasunsolar.com"

# ------------------------------------------------------------------------------
# 2. SUPABASE DATABASE (SERVER-SIDE ONLY - NEVER PREFIX WITH NEXT_PUBLIC_)
# ------------------------------------------------------------------------------
# Inbound leads from the quote form, contact form, and popup are saved directly into Supabase.
# Create a dedicated free project for each client at https://supabase.com
# Find these credentials in Project Settings -> API.
SUPABASE_URL="https://your-project-id.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-secret-key-here"

# ------------------------------------------------------------------------------
# 3. UPSTASH REDIS (OPTIONAL - FOR DISTRIBUTED RATE LIMITING ON SERVERLESS)
# ------------------------------------------------------------------------------
# If left empty, an in-memory rate limiter is used as a best-effort fallback.
# For high-traffic production deployments on Vercel, create a free database at https://upstash.com
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# ------------------------------------------------------------------------------
# 4. OWNER EMAIL NOTIFICATIONS (OPTIONAL HOOK VIA RESEND)
# ------------------------------------------------------------------------------
# If you want immediate email notifications sent to the solar company owner when a lead is captured:
# Sign up at https://resend.com and add your API key below.
# RESEND_API_KEY=""
# NOTIFICATION_EMAIL="sales@aurasunsolar.com"

# ------------------------------------------------------------------------------
# NOTE ON WHATSAPP NOTIFICATIONS:
# Fully automated, server-to-phone WhatsApp notifications to the company owner require
# a Meta WhatsApp Business Cloud API account with pre-approved message templates.
# To keep this platform zero-cost and client-friendly, visitors are instead given a
# one-click "Send enquiry on WhatsApp" button that pre-fills their exact details.
# ------------------------------------------------------------------------------
