# ==============================================================================
# AuraSun Solar Website Platform - Environment Variables
# Copy this file to .env.local for local development.
# Configure each client deployment with its own unique production values.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. SITE & CANONICAL DOMAIN
# ------------------------------------------------------------------------------
# The public production URL of this solar client's website (used for sitemaps, JSON-LD, metadata)
NEXT_PUBLIC_SITE_URL="https://aurasunsolar.com"

# ------------------------------------------------------------------------------
# 2. SUPABASE DATABASE (SERVER-SIDE ONLY - NEVER PREFIX WITH NEXT_PUBLIC_)
# ------------------------------------------------------------------------------
# Inbound leads, quotations, A4 estimates, and bills are stored in Supabase.
# Find the project URL and Secret key in Supabase -> Project Settings -> API Keys.
# Secret keys are server-only and bypass RLS. Never add a NEXT_PUBLIC_ prefix.
SUPABASE_URL="https://your-project-id.supabase.co"
SUPABASE_SECRET_KEY="sb_secret_your-secret-key-here"
# Older projects can use the legacy service_role key instead of SUPABASE_SECRET_KEY.
# SUPABASE_SERVICE_ROLE_KEY="your-legacy-service-role-key-here"

# ------------------------------------------------------------------------------
# 3. OWNER EMAIL NOTIFICATIONS (OPTIONAL HOOK VIA RESEND)
# ------------------------------------------------------------------------------
# If you want immediate email notifications sent to the solar company owner when a lead is captured:
# Sign up at https://resend.com and add your API key below.
# RESEND_API_KEY=""
# NOTIFICATION_EMAIL="sales@aurasunsolar.com"

# ------------------------------------------------------------------------------
# 4. QUOTATION SYSTEM STAFF LOGIN CREDENTIALS
# ------------------------------------------------------------------------------
# Set private staff credentials for /quotation (1-10 characters). Never use the NEXT_PUBLIC_ prefix.
QUOTATION_LOGIN_ID="your-id-10"
QUOTATION_LOGIN_PASSWORD="your-pass9"
# Master password for permanently removing an estimate from the active list (1-10 characters).
# Keep it private; a staff session and estimate-number confirmation are also required.
# This password is checked server-side and is never stored in Supabase.
ESTIMATE_DELETE_MASTER_PASSWORD=""

# Optional registered business tax details. A valid GSTIN is required before GST is charged.
COMPANY_GSTIN=""
# Optional private account number printed on generated invoices.
COMPANY_BANK_ACCOUNT=""
# Optional prefixes used for generated invoice and estimate numbers (letters, numbers, and dashes).
BILL_NUMBER_PREFIX="ME"
ESTIMATE_NUMBER_PREFIX="ME"
